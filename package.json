{
  "name": "the-alexandrian-reader",
  "version": "1.1.0",
  "description": "A private offline PDF and EPUB library inspired by the Library of Alexandria.",
  "author": "The Alexandrian",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "desktop:dev": "vite --config vite.desktop.config.ts",
    "desktop:start": "electron .",
    "smoke": "electron tests/electron-smoke.cjs",
    "desktop:build": "vite build --config vite.desktop.config.ts && electron-builder --win nsis portable",
    "build": "vite build --config vite.desktop.config.ts",
    "test": "npm run build && node --test tests/catalogue.test.cjs"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "pdf-lib": "^1.17.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "build": {
    "appId": "com.alexandrian.reader",
    "productName": "The Alexandrian",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "desktop-dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "The-Alexandrian-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "The-Alexandrian-Portable-${version}-${arch}.${ext}"
    }
  }
}
