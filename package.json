{
  "name": "mouseion",
  "version": "1.3.0",
  "description": "Mouseion — a private offline PDF and EPUB library inspired by ancient Alexandria.",
  "author": "Anant Goel",
  "license": "MIT",
  "repository": "github:Anantgoel2005/Mouseion",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "desktop:dev": "vite --config vite.desktop.config.ts",
    "desktop:start": "electron .",
    "smoke": "electron tests/electron-smoke.cjs",
    "desktop:build": "vite build --config vite.desktop.config.ts && electron-builder --win nsis portable",
    "desktop:package": "npm run build && electron-builder --win dir",
    "build": "vite build --config vite.desktop.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/catalogue.test.cjs tests/protocol.test.cjs",
    "verify": "npm run typecheck && npm test && npm run smoke && npm audit --audit-level=high"
  },
  "dependencies": {
    "epubjs": "0.3.93",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "pdf-lib": "^1.17.1",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.8.13"
    }
  },
  "type": "module",
  "build": {
    "appId": "com.alexandrian.reader",
    "productName": "Mouseion",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "desktop-dist/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Mouseion-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "Mouseion-Portable-${version}-${arch}.${ext}"
    }
  }
}
